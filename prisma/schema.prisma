generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RequestStatus {
  submitted
  under_review
  quoted
  approved
  rejected
  cancelled
}

model ServiceRequest {
  id           String        @id @default(cuid())
  serviceSlug  String
  category     String
  customerName String?
  email        String?
  phone        String?
  payload      Json

  status       RequestStatus @default(submitted)
  adminNotes   String?

  quoteAmount  Int?
  quoteCurrency String?      @default("NGN")
  quoteMessage String?

  // Payment integration placeholder fields
  paymentProvider String?
  paymentStatus   String?
  paymentRef      String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([serviceSlug])
  @@index([category])
  @@index([status])
  @@map("service_requests")
}
