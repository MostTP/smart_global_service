# Neon Postgres — create a project at https://console.neon.tech and paste the connection string.
# Use the pooled URI for serverless (includes `-pooler` in the host) in production when applicable.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: Prisma Migrate prefers a direct (non-pooler) URL when DATABASE_URL uses Neon pooler.
# Uncomment and set from Neon "Connection string" → non-pooling if migrations fail.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin seed (optional overrides for prisma/seed.ts)
ADMIN_SEED_EMAIL="admin@smartglobalservice.local"
ADMIN_SEED_PASSWORD="change-me-admin-9"

# Server-to-server admin API (optional; header x-admin-key)
ADMIN_API_KEY=""

# Stripe (default payment provider)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="stripe"

# Paystack (set PAYMENT_PROVIDER=paystack and configure NGN amounts)
PAYSTACK_SECRET_KEY=""
PAYSTACK_CURRENCY="NGN"

# Email / SMS (optional — logs to console if omitted)
RESEND_API_KEY=""
EMAIL_FROM="SGS <onboarding@resend.dev>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
